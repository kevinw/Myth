<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationTitle>TinyLink</ApplicationTitle>
    <ApplicationId>com.kev.tinylink</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <MtouchLink>SdkOnly</MtouchLink>
    <StartupObject>TinyLinkIos.Program</StartupObject>
    <PartialAppManifest>Info.plist</PartialAppManifest>
    <DefineConstants>$(DefineConstants);IOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey Condition="'$(CodesignKey)' == ''">Apple Development</CodesignKey>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'DebugInterp' ">
    <CodesignKey Condition="'$(CodesignKey)' == ''">Apple Development</CodesignKey>
    <MtouchInterpreter>all,-TinyLinkIos,-Foster.Framework</MtouchInterpreter>
    <MtouchLink>SdkOnly</MtouchLink>
    <TrimMode>copy</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <BundleResource Include="../../../Assets/**/*"
                    Exclude="../../../Assets/**/.DS_Store;../../../Assets/Sounds/**">
      <LogicalName>Assets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </BundleResource>
    <ProjectReference Include="../../../Source/TinyLink.Core.csproj" />
    <ProjectReference Include="../../../../../Foster/Framework/Foster.Framework.csproj" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../Native/SDL3.xcframework')">
    <NativeReference Include="../Native/SDL3.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="Exists('../Native/cimgui.xcframework')">
    <NativeReference Include="../Native/cimgui.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AudioToolbox" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AVFoundation" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AVFAudio" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and Exists('../Native/FMOD/core/lib/libfmod_iphoneos.a')">
    <NativeReference Include="../Native/FMOD/studio/lib/libfmodstudio_iphoneos.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="../Native/FMOD/core/lib/libfmod_iphoneos.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
  </ItemGroup>

</Project>
