<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>14.2</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationTitle>TinyLink Smoke</ApplicationTitle>
    <ApplicationId>com.kev.tinylink.smoke</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <MtouchLink>SdkOnly</MtouchLink>
    <PartialAppManifest>Info.plist</PartialAppManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../../Foster/Framework/Foster.Framework.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../Native/SDL3.xcframework')">
    <NativeReference Include="../Native/SDL3.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

</Project>
