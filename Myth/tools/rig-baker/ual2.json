{
  "skeleton": {
    "filename": "skeleton.ozz",
    "import": {
      "enable": true,
      "raw": false,
      "types": {
        "skeleton": true,
        "marker": false,
        "camera": false,
        "geometry": false,
        "light": false,
        "null": false,
        "any": false
      }
    }
  },
  "animations": [
    {
