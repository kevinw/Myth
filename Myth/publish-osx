#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

CONFIGURATION="${CONFIGURATION:-Release}"
RUNTIME_IDENTIFIER="${RUNTIME_IDENTIFIER:-osx-arm64}"

openssl_prefix="$(brew --prefix openssl@3 2>/dev/null || true)"
brotli_prefix="$(brew --prefix brotli 2>/dev/null || true)"

openssl_lib="${openssl_prefix:-/opt/homebrew/opt/openssl@3}/lib"
brotli_lib="${brotli_prefix:-/opt/homebrew/opt/brotli}/lib"

export LIBRARY_PATH="${openssl_lib}:${brotli_lib}:${LIBRARY_PATH:-}"

dotnet publish \
	-c "${CONFIGURATION}" \
	-r "${RUNTIME_IDENTIFIER}" \
	-p:PublishAot=true \
	--self-contained true \
	--disable-build-servers
