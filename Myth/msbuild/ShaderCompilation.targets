<Project>
  <!--
    Myth Shader Compilation - imports Foster's shader compilation targets
  -->

  <PropertyGroup>
    <ShaderSourceDir>$(MSBuildThisFileDirectory)../Assets/Shaders</ShaderSourceDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../Foster/msbuild/ShaderCompilation.targets" />

  <ItemGroup>
    <_ShaderCompile Update="$(ShaderSourceDir)/Compute/NCAPresent.hlsl;$(ShaderSourceDir)/Compute/NeuralTextureDecode.hlsl">
      <WebWriteOnlyStorageTexture>true</WebWriteOnlyStorageTexture>
    </_ShaderCompile>
  </ItemGroup>

  <Target Name="_FixWebWriteOnlyStorageTextures"
          AfterTargets="_CompileShadersWeb"
          Condition="'$(ShaderPlatform)' == 'web'">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../tools/wgsl-write-only.py&quot; &quot;%(_ShaderCompile.OutputFile)&quot;"
          Condition="'%(_ShaderCompile.WebWriteOnlyStorageTexture)' == 'true'" />
  </Target>

</Project>
