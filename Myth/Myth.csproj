<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- App identity lives in app.json, shared with tools/publish-macos.mjs and
       tools/mac/clear-metal-cache.sh. It reaches C# as the generated Myth.AppInfo, the Windows
       exe's version info, and the browser page title. -->
  <PropertyGroup>
    <MythAppJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/app.json'))</MythAppJson>
    <MythAppName>$([System.Text.RegularExpressions.Regex]::Match($(MythAppJson), '"name"\s*:\s*"([^"]*)"').Groups[1].Value.Trim())</MythAppName>
    <MythAppCompany>$([System.Text.RegularExpressions.Regex]::Match($(MythAppJson), '"company"\s*:\s*"([^"]*)"').Groups[1].Value.Trim())</MythAppCompany>
    <MythAppBundleId>$([System.Text.RegularExpressions.Regex]::Match($(MythAppJson), '"bundleId"\s*:\s*"([^"]*)"').Groups[1].Value.Trim())</MythAppBundleId>
    <MythSteamAppId>$([System.Text.RegularExpressions.Regex]::Match($(MythAppJson), '"steamAppId"\s*:\s*"([^"]*)"').Groups[1].Value.Trim())</MythSteamAppId>
    <Product>$(MythAppName)</Product>
    <AssemblyTitle>$(MythAppName)</AssemblyTitle>
    <Company>$(MythAppCompany)</Company>
  </PropertyGroup>

  <!-- The name also names the settings/save folder, so a missing value fails the build instead of
       silently moving everyone's saves. -->
  <Target Name="MythGenerateAppInfo" BeforeTargets="CoreCompile">
    <Error Condition="'$(MythAppName)' == '' or '$(MythAppCompany)' == '' or '$(MythAppBundleId)' == '' or '$(MythSteamAppId)' == ''"
           Text="app.json must set non-empty &quot;name&quot;, &quot;company&quot;, &quot;bundleId&quot;, and &quot;steamAppId&quot; (got name='$(MythAppName)', company='$(MythAppCompany)', bundleId='$(MythAppBundleId)')." />
    <WriteLinesToFile File="$(IntermediateOutputPath)AppInfo.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated from app.json by Myth.csproj.;namespace Myth%3B;static class AppInfo;{;public const string Name = &quot;$(MythAppName)&quot;%3B;public const string Company = &quot;$(MythAppCompany)&quot;%3B;public const string BundleId = &quot;$(MythAppBundleId)&quot;%3B;public const uint SteamAppId = $(MythSteamAppId)%3B;}" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AppInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Shipped Windows builds launch without a console window (GUI subsystem). Dev and CLI runs
       (dotnet run, gym, asset-pack builds) keep the console for their stdout. The subsystem flag
       only lives in the Windows PE header, so it applies to builds targeting Windows from any host.
       Logs still go to %APPDATA%\Human Questions\logs via the tee installed in Program.cs. -->
  <PropertyGroup Condition="'$(MythShip)' == 'true' and ('$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- Shipped macOS builds (tools/publish-macos.mjs): play-only NativeAOT. Set here
       rather than on the publish command line so the property doesn't leak into projects
       that don't support AOT (Myth.SourceGen targets netstandard). -->
  <PropertyGroup Condition="'$(MythShip)' == 'true' and '$(RuntimeIdentifier)' != 'browser-wasm'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- Drops ~180 KB of culture data, and keeps float parsing/formatting locale-proof. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Homebrew's dotnet ships a non-portable (source-build) ILC pack that links system
       OpenSSL and Brotli the way Linux distros do; macOS provides neither as linkable
       libraries. The game uses no TLS and no Brotli, so drop the flags — dead_strip means
       the archive members that would need them are never pulled in. (Official Microsoft
       SDKs don't add these on macOS at all.) -->
  <Target Name="MythStripNonPortableSystemLibs" AfterTargets="SetupOSSpecificProps" Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <LinkerArg Remove="-lssl" />
      <LinkerArg Remove="-lcrypto" />
      <LinkerArg Remove="-lbrotlienc" />
      <LinkerArg Remove="-lbrotlidec" />
      <LinkerArg Remove="-lbrotlicommon" />
    </ItemGroup>
  </Target>

  <!-- Cross-building the Linux game from macOS (tools/publish-linux.mjs). ILC emits a
       linux-x64 object file on any host; only the link is host-specific, and zig supplies
       the ELF linker plus a glibc sysroot. Homebrew's llvm has the matching objcopy. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == 'linux-x64' and $([MSBuild]::IsOSPlatform('OSX'))">
    <CppCompilerAndLinker Condition="'$(CppCompilerAndLinker)' == ''">$(MSBuildProjectDirectory)/tools/linux-cross-cc.sh</CppCompilerAndLinker>
    <ObjCopyName Condition="'$(ObjCopyName)' == '' and Exists('/opt/homebrew/opt/llvm/bin/llvm-objcopy')">/opt/homebrew/opt/llvm/bin/llvm-objcopy</ObjCopyName>
    <ObjCopyName Condition="'$(ObjCopyName)' == ''">llvm-objcopy</ObjCopyName>
  </PropertyGroup>

  <!-- Cross-building the Windows game from macOS (tools/publish-windows.mjs). ILC emits a win-x64
       object file on any host; the NativeAOT targets only find MSVC via vcvarsall, so link with
       lld-link against the CRT + Windows SDK import libs `xwin splat` put in WindowsCrossSdkRoot
       (crt/lib/x86_64, sdk/lib/{um,ucrt}/x86_64). Host setup is in tools/publish-windows.mjs. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64' and !$([MSBuild]::IsOSPlatform('Windows'))">
    <MythWindowsCross>true</MythWindowsCross>
    <WindowsCrossSdkRoot Condition="'$(WindowsCrossSdkRoot)' == ''">$(MYTH_WIN_SDK_ROOT)</WindowsCrossSdkRoot>
    <WindowsCrossSdkRoot Condition="'$(WindowsCrossSdkRoot)' == ''">$(HOME)/win-sdk</WindowsCrossSdkRoot>
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    <!-- lld-link reads MSVC's /SOURCELINK option as an input file. -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <!-- The Windows NativeAOT targets set CppLinker=link after the project's own properties. -->
  <Target Name="MythUseLldLink" AfterTargets="SetupOSSpecificProps" Condition="'$(MythWindowsCross)' == 'true'">
    <PropertyGroup>
      <CppLinker>/opt/homebrew/opt/lld/bin/lld-link</CppLinker>
    </PropertyGroup>
  </Target>
  <ItemGroup Condition="'$(MythWindowsCross)' == 'true'">
    <LinkerArg Include="/LIBPATH:&quot;$(WindowsCrossSdkRoot)/sdk/lib/um/x86_64&quot;" />
    <LinkerArg Include="/LIBPATH:&quot;$(WindowsCrossSdkRoot)/sdk/lib/ucrt/x86_64&quot;" />
    <LinkerArg Include="/LIBPATH:&quot;$(WindowsCrossSdkRoot)/crt/lib/x86_64&quot;" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <FmodNativeDir>$(MSBuildProjectDirectory)/Platforms/FMOD/Native/</FmodNativeDir>
  </PropertyGroup>

  <!-- MythShip strips the editor from a published game build; ImGui stays available
       (potential in-game UI), so only EDITOR is dropped. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <DefineConstants Condition="'$(MythTestShip)' == 'true'">$(DefineConstants);IMGUI</DefineConstants>
    <DefineConstants Condition="'$(MythTestShip)' != 'true' and '$(MythShip)' != 'true'">$(DefineConstants);EDITOR;IMGUI</DefineConstants>
    <DefineConstants Condition="'$(MythTestShip)' != 'true' and '$(MythShip)' == 'true'">$(DefineConstants);IMGUI</DefineConstants>
    <DefineConstants Condition="'$(MythShip)' == 'true'">$(DefineConstants);MYTHSHIP</DefineConstants>
    <DefineConstants Condition="'$(MythShip)' != 'true'">$(DefineConstants);KIT_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <DefineConstants>$(DefineConstants);BROWSER;BROWSER_JS_FMOD</DefineConstants>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <MythBrowser>true</MythBrowser>
    <WasmEmitSymbolMap Condition="'$(Configuration)' == 'Release' and '$(WasmEmitSymbolMap)' == ''">false</WasmEmitSymbolMap>
    <MythBrowserThreads Condition="'$(MythBrowserThreads)' == ''">false</MythBrowserThreads>
    <WasmEnableThreads Condition="'$(MythBrowserThreads)' == 'true'">true</WasmEnableThreads>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmMainJSPath>Platforms/Web/wwwroot/main.js</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Dear ImGui for the browser: link the prebuilt cimgui wasm archive into the
       runtime (built by tools/build-cimgui-web.sh). Linking native code forces a
       native relink of dotnet.native.wasm. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(MythBrowserImGui)' != 'false' and Exists('Platforms/Web/Native/cimgui.a')">
    <MythBrowserImGui>true</MythBrowserImGui>
    <DefineConstants>$(DefineConstants);IMGUI</DefineConstants>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- The web cimgui archive is pinned to ImGui.NET's native ABI. ImGui.NET still
         P/Invokes a few functions this cimgui build does not export; they are never
         called here, so leave them unresolved instead of failing the static link. -->
    <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(MythBrowserImGui)' == 'true'">
    <NativeFileReference Include="Platforms/Web/Native/cimgui.a" />
  </ItemGroup>

  <!-- Browser-wasm AOT. mono-aot-cross used to crash compiling Foster.Framework with an
       SGen GC assert (sgen-alloc.c:409 `*p == NULL`); we traced it to the array-typed
       [UnmanagedCallConv(CallConvs=[...])] custom attribute on SDL3.cs's LibraryImports,
       and our Foster fork strips it (safe: cdecl is already the default unmanaged calling
       convention on every target Foster ships — wasm/x64/arm64; only win-x86, which Foster
       does not build, would differ). Foster now AOTs cleanly, so we AOT it by DEFAULT:
       uniform AOT also avoids the AOT<->interpreter "function signature mismatch" the old
       mixed-mode build hit at runtime. Set MythBrowserAotFoster=false to fall back to
       interpreting Foster. See memory wasm-aot-foster-blocker and upstream-mono-aot-sgen-crash.md. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(MythBrowserAot)' == 'true' and '$(MythBrowserAotFoster)' == ''">
    <MythBrowserAotFoster>true</MythBrowserAotFoster>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(MythBrowserAot)' == 'true' and '$(MythBrowserAotFoster)' != 'true'">
    <_AOT_InternalForceInterpretAssemblies Include="Foster.Framework.dll" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ShaderPlatform>mac</ShaderPlatform>
    <ShaderOutputExtension>msl</ShaderOutputExtension>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ShaderPlatform>windows</ShaderPlatform>
    <ShaderOutputExtension>dxil</ShaderOutputExtension>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ShaderPlatform>linux</ShaderPlatform>
    <ShaderOutputExtension>spv</ShaderOutputExtension>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <ShaderPlatform>web</ShaderPlatform>
  </PropertyGroup>

  <!-- Shader compilation -->
  <PropertyGroup>
    <ShaderSourceDir>$(MSBuildProjectDirectory)/Assets/Shaders</ShaderSourceDir>
  </PropertyGroup>

  <Import Project="msbuild/ShaderCompilation.targets" />

  <!-- Hook shader compilation into the build -->
  <Target Name="_CompileShadersBeforeBuild" BeforeTargets="BeforeBuild" DependsOnTargets="CompileShaders" />

  <ItemGroup>
    <Compile Remove="Source/**" />
    <Compile Remove="Platforms/**" />
    <Compile Remove="tools/**" />
    <EmbeddedResource Remove="Platforms/**" />
    <None Remove="Platforms/**" />
  </ItemGroup>

  <ItemGroup>
    <CoreCompileCache Include="$(DefineConstants)" />
    <Compile Include="Source/**/*.cs" Exclude="Source/**/bin/**;Source/**/obj/**;Source/External/StringBuilder/tests/**" />
    <Compile Include="../Kit/**/*.cs" Exclude="../Kit/**/bin/**;../Kit/**/obj/**;../Kit/**/Tests/**" Link="Kit/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Build-time only: emits GeneratedActors.RegisterAll() from [GameActor]. -->
    <ProjectReference Include="tools/Myth.SourceGen/Myth.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseFosterDll)' != 'true'">
    <ProjectReference Include="../Foster/Framework/Foster.Framework.csproj" AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseFosterDll)' == 'true'">
    <Reference Include="Foster.Framework">
      <HintPath>../Foster/Framework/bin/$(Configuration)/net10.0/Foster.Framework.dll</HintPath>
    </Reference>
    <Content Include="../Foster/Framework/Internal/Native/win-x64/**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or '$(RuntimeIdentifier)' == 'win-x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or '$(RuntimeIdentifier)' == 'win-x64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="../Foster/Framework/Internal/Native/linux-x64/**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))) or '$(RuntimeIdentifier)' == 'linux-x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))) or '$(RuntimeIdentifier)' == 'linux-x64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="../Foster/Framework/Internal/Native/osx-arm64/**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64') or '$(RuntimeIdentifier)' == 'osx-arm64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64') or '$(RuntimeIdentifier)' == 'osx-arm64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="../Foster/Framework/Internal/Native/osx-x64/**" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64') or '$(RuntimeIdentifier)' == 'osx-x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64') or '$(RuntimeIdentifier)' == 'osx-x64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="_RequireFosterDll" BeforeTargets="ResolveReferences" Condition="'$(UseFosterDll)' == 'true'">
    <Error Condition="!Exists('../Foster/Framework/bin/$(Configuration)/net10.0/Foster.Framework.dll')"
           Text="UseFosterDll=true requires ../Foster/Framework/bin/$(Configuration)/net10.0/Foster.Framework.dll. Build Foster once for this configuration, or omit UseFosterDll." />
  </Target>

  <!-- The tools/ helper projects reference Foster as a project, so their bin/ carries its own copy of
       Foster.Framework.dll. Under UseFosterDll=true, MSBuild's assembly resolver can pick that copy
       over our HintPath DLL; if a tool wasn't rebuilt after Foster changed, it links a *stale* Foster
       (e.g. missing a new AppFlags) and the Myth compile fails with a confusing "no definition"
       error. We can't just delete the shadow (the resolver latches it as a candidate at evaluation
       time, then errors when it's missing), so instead overwrite each shadow with the current DLL —
       whichever copy the resolver picks is then up to date. -->
  <Target Name="_RefreshShadowingFosterDlls" BeforeTargets="ResolveReferences" Condition="'$(UseFosterDll)' == 'true'">
    <ItemGroup>
      <_ShadowFosterDll Include="tools/**/bin/**/Foster.Framework.dll" />
    </ItemGroup>
    <Copy Condition="'@(_ShadowFosterDll)' != ''"
          SourceFiles="@(_ShadowFosterDll->'$(MSBuildProjectDirectory)/../Foster/Framework/bin/$(Configuration)/net10.0/Foster.Framework.dll')"
          DestinationFiles="@(_ShadowFosterDll)"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Condition="'@(_ShadowFosterDll)' != ''"
             Text="Refreshed shadowing Foster.Framework.dll in tools/ from ../Foster/Framework/bin/$(Configuration): @(_ShadowFosterDll)" />
  </Target>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <None Update="AppIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(MythShip)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm' and '$(MythShip)' != 'true'">
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
  </ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm' and '$(MythTestShip)' != 'true' and '$(MythShip)' != 'true'">
		<PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
		<PackageReference Include="Anthropic" Version="12.55.0" />
		<None Remove="EditorAssets/**" />
		<Content Include="EditorAssets/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <Content Include="$(FmodNativeDir)win-x64/*.dll" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or '$(RuntimeIdentifier)' == 'win-x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or '$(RuntimeIdentifier)' == 'win-x64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(FmodNativeDir)osx/*.dylib" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))) or '$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))) or '$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(FmodNativeDir)linux-x64/*.so*" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' != 'Arm64') or '$(RuntimeIdentifier)' == 'linux-x64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' != 'Arm64') or '$(RuntimeIdentifier)' == 'linux-x64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="$(FmodNativeDir)linux-arm64/*.so*" Visible="false">
      <CopyToOutputDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64') or '$(RuntimeIdentifier)' == 'linux-arm64'">PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64') or '$(RuntimeIdentifier)' == 'linux-arm64'">PreserveNewest</CopyToPublishDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Steamworks (vendored in ../native/Steamworks, see its README). Desktop only: the browser has
       no Steam. The steam_api binary is picked by RID, falling back to the host OS for plain builds,
       and must agree with the Steamworks.NET project's own per-platform P/Invoke setup.
       STEAM switches Kit's Steam wrapper from its no-op body to the real one. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <MythSteamDir>../native/Steamworks/</MythSteamDir>
    <MythSteamFlavour Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or '$(RuntimeIdentifier)' == 'win-x64'">windows</MythSteamFlavour>
    <MythSteamFlavour Condition="'$(MythSteamFlavour)' == ''">osx-linux</MythSteamFlavour>
    <MythSteamNative Condition="('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))) or '$(RuntimeIdentifier)' == 'win-x64'">steam_api64.dll</MythSteamNative>
    <MythSteamNative Condition="'$(MythSteamNative)' == '' and (('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))) or $(RuntimeIdentifier.StartsWith('linux')))">libsteam_api.so</MythSteamNative>
    <MythSteamNative Condition="'$(MythSteamNative)' == ''">libsteam_api.dylib</MythSteamNative>
    <MythSteamworksPlatform Condition="'$(MythSteamFlavour)' == 'windows'">STEAMWORKS_WIN</MythSteamworksPlatform>
    <MythSteamworksPlatform Condition="'$(MythSteamworksPlatform)' == ''">STEAMWORKS_LIN_OSX</MythSteamworksPlatform>
    <DefineConstants>$(DefineConstants);STEAM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <ProjectReference Include="$(MythSteamDir)Steamworks.NET.csproj" AdditionalProperties="SteamworksPlatform=$(MythSteamworksPlatform)" />
    <Content Include="$(MythSteamDir)$(MythSteamFlavour)/$(MythSteamNative)" Visible="false"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="$(MythSteamNative)" />
  </ItemGroup>

  <!-- Dev/test only: it makes an un-installed build report itself as MythSteamAppId. A real Steam
       release must not ship it: Steam supplies the id to the launched process. -->
  <Target Name="MythWriteSteamAppId" AfterTargets="Build;Publish" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <WriteLinesToFile File="$(OutDir)steam_appid.txt" Lines="$(MythSteamAppId)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(PublishDir)steam_appid.txt" Lines="$(MythSteamAppId)" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- Managed bindings only; the native cimgui wasm archive is linked above. -->
  <ItemGroup Condition="'$(MythBrowserImGui)' == 'true'">
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Content Include="Platforms/Web/wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <NativeFileReference Include="../Foster/Framework/Internal/Native/browser/foster_png_decode.cpp" />
    <NativeFileReference Include="../Foster/Framework/Internal/Native/browser/lodepng/foster_lodepng.cpp" />
  </ItemGroup>

  <Target Name="GenerateWebUiAssets"
          BeforeTargets="CopyBrowserShell"
          Inputs="Production/WebUI/gamepad.ase"
          Outputs="Platforms/Web/wwwroot/loading-gamepad.webp"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Exec Command="dotnet run --project tools/WebUiAssetExporter/WebUiAssetExporter.csproj -- Production/WebUI/gamepad.ase Platforms/Web/wwwroot/loading-gamepad.webp" />
  </Target>

  <Target Name="CopyBrowserShell" AfterTargets="WasmGenerateAppBundle" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <!-- The shipped Assets folder (Content.pak + FMOD banks), staged by run-browser.mjs or CI. -->
    <Error Condition="!Exists('obj/Content/browser/Assets/Content.pak')"
           Text="Browser content is missing. Build with tools/run-browser.mjs, or run the game with --stage-content browser first." />
    <ItemGroup>
      <_StagedContent Include="obj/Content/browser/Assets/**" />
    </ItemGroup>
    <MakeDir Directories="$(WasmAppDir)_framework/Content/Web" />
    <MakeDir Directories="$(WasmAppDir)FMOD" />
    <MakeDir Directories="$(WasmAppDir)acknowledgements" />
    <!-- index.html with the <title> from app.json. Escaped so WriteLinesToFile keeps it one item. -->
    <PropertyGroup>
      <_MythBrowserIndexHtml>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Platforms/Web/wwwroot/index.html')), '&lt;title&gt;[^&lt;]*&lt;/title&gt;', '&lt;title&gt;$(MythAppName)&lt;/title&gt;'))</_MythBrowserIndexHtml>
    </PropertyGroup>
    <WriteLinesToFile File="$(WasmAppDir)index.html" Lines="$([MSBuild]::Escape($(_MythBrowserIndexHtml)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(IntermediateOutputPath)acknowledgements/index.html" DestinationFolder="$(WasmAppDir)acknowledgements" />
    <Copy SourceFiles="Platforms/Web/wwwroot/main.js" DestinationFolder="$(WasmAppDir)" />
    <Copy SourceFiles="Platforms/Web/wwwroot/virtual-gamepad.js" DestinationFolder="$(WasmAppDir)" />
    <Copy SourceFiles="Platforms/Web/wwwroot/loading-duck.webp" DestinationFolder="$(WasmAppDir)" />
    <Copy SourceFiles="Platforms/Web/wwwroot/loading-gamepad.webp" DestinationFolder="$(WasmAppDir)" />
    <Copy SourceFiles="Platforms/Web/wwwroot/_headers" DestinationFolder="$(WasmAppDir)" />
    <Copy SourceFiles="Platforms/Web/wwwroot/_routes.json" DestinationFolder="$(WasmAppDir)" />
    <Copy SourceFiles="../Foster/Framework/Content/Web/foster-webgpu.js" DestinationFolder="$(WasmAppDir)_framework/Content/Web" />
    <Copy SourceFiles="Platforms/Web/FMOD/myth-fmod.js" DestinationFolder="$(WasmAppDir)FMOD" />
    <Copy SourceFiles="Platforms/Web/FMOD/fmodstudioP.js" DestinationFolder="$(WasmAppDir)FMOD" />
    <Copy SourceFiles="Platforms/Web/FMOD/fmodstudioP.wasm" DestinationFolder="$(WasmAppDir)FMOD" />
    <Copy SourceFiles="@(Content)" DestinationFiles="@(Content->'$(WasmAppDir)%(Identity)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_StagedContent)" DestinationFolder="$(WasmAppDir)Assets/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Exec Command="python3 tools/generate-browser-asset-manifest.py &quot;$(WasmAppDir)&quot;" />
  </Target>

  <Target Name="GenerateAcknowledgementsPage"
          BeforeTargets="CopyBrowserShell"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm'"
          Inputs="ACKNOWLEDGEMENTS.txt;tools/generate-acknowledgements.mjs"
          Outputs="$(IntermediateOutputPath)acknowledgements/index.html">
    <MakeDir Directories="$(IntermediateOutputPath)acknowledgements" />
    <Exec Command="node tools/generate-acknowledgements.mjs ACKNOWLEDGEMENTS.txt &quot;$(IntermediateOutputPath)acknowledgements/index.html&quot;" />
  </Target>

  <Target Name="GenerateDashboard" BeforeTargets="CopyBrowserShell" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Exec Command="python3 tools/generate-dashboard.py" Condition="'$(Configuration)' == 'Release' or !Exists('Platforms/Web/dashboard/data.json')" />
    <MakeDir Directories="$(WasmAppDir)dashboard" />
    <ItemGroup>
      <DashboardFiles Include="Platforms/Web/dashboard/**" />
    </ItemGroup>
    <Copy SourceFiles="@(DashboardFiles)" DestinationFiles="@(DashboardFiles->'$(WasmAppDir)dashboard/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateBrowserFmod" BeforeTargets="WasmGenerateAppBundle" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Error
      Condition="!Exists('Platforms/Web/FMOD/myth-fmod.js') or !Exists('Platforms/Web/FMOD/fmodstudioP.js') or !Exists('Platforms/Web/FMOD/fmodstudioP.wasm')"
      Text="Myth browser FMOD runtime files are missing from Platforms/Web/FMOD/." />
  </Target>

  <!-- Native ScreenCaptureKit window recorder (see native/MythCapture, used by the 'M'
       record shortcut). Built + copied for macOS non-ship builds (Debug or Release), so it's
       available for performant Release captures but never lands in a ship publish
       (MythShip=true). ContinueOnError keeps the C# build working even without a Swift
       toolchain (the feature just reports it's missing). C# is likewise gated on #if !MYTHSHIP. -->
  <Target Name="BuildMythCapture"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(MythShip)' != 'true'"
          Inputs="../native/MythCapture/MythCapture.swift"
          Outputs="../native/MythCapture/libMythCapture.dylib">
    <Exec Command="bash '$(MSBuildProjectDirectory)/../native/MythCapture/build.sh'" ContinueOnError="true" />
  </Target>

  <Target Name="CopyMythCapture"
          AfterTargets="Build"
          DependsOnTargets="BuildMythCapture"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(MythShip)' != 'true' And Exists('../native/MythCapture/libMythCapture.dylib')">
    <Copy SourceFiles="../native/MythCapture/libMythCapture.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <EnableOzzRuntime Condition="'$(EnableOzzRuntime)' == ''">true</EnableOzzRuntime>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableOzzRuntime)' == 'true' And $([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <OzzRuntimeLibrary>$(BaseIntermediateOutputPath)ozz-runtime/libmyth_ozz.dylib</OzzRuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableOzzRuntime)' == 'true' And (($([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64')) Or ('$(RuntimeIdentifier)' == 'win-x64' And $([MSBuild]::IsOSPlatform('OSX'))))">
    <OzzRuntimeLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(BaseIntermediateOutputPath)ozz-runtime/MinSizeRel/myth_ozz.dll</OzzRuntimeLibrary>
    <OzzRuntimeLibrary Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(BaseIntermediateOutputPath)ozz-runtime/myth_ozz.dll</OzzRuntimeLibrary>
    <OzzRuntimeCrossTarget Condition="!$([MSBuild]::IsOSPlatform('Windows'))">win-x64</OzzRuntimeCrossTarget>
  </PropertyGroup>

  <!-- A Linux RID targets Linux from any host; a bare RID means whatever the host is.
       Building it from elsewhere hands the RID to the CMake toolchain as a cross target. -->
  <PropertyGroup Condition="'$(EnableOzzRuntime)' == 'true' And ('$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64' Or ($([MSBuild]::IsOSPlatform('Linux')) And '$(RuntimeIdentifier)' == ''))">
    <OzzRuntimeLibrary>$(BaseIntermediateOutputPath)ozz-runtime/libmyth_ozz.so</OzzRuntimeLibrary>
    <OzzRuntimeCrossTarget Condition="!$([MSBuild]::IsOSPlatform('Linux'))">$(RuntimeIdentifier)</OzzRuntimeCrossTarget>
  </PropertyGroup>

  <Target Name="BuildOzzRuntime"
          BeforeTargets="Build"
          Condition="'$(OzzRuntimeLibrary)' != ''">
    <Exec Command="node tools/rig-baker/build-runtime.mjs &quot;$(BaseIntermediateOutputPath)ozz-runtime&quot; $(OzzRuntimeCrossTarget)" />
  </Target>

  <Target Name="CopyOzzRuntime"
          AfterTargets="Build"
          DependsOnTargets="BuildOzzRuntime"
          Condition="'$(OzzRuntimeLibrary)' != '' And Exists('$(OzzRuntimeLibrary)')">
    <Copy SourceFiles="$(OzzRuntimeLibrary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyOzzRuntimeToPublish"
          AfterTargets="Publish"
          DependsOnTargets="BuildOzzRuntime"
          Condition="'$(OzzRuntimeLibrary)' != '' And '$(PublishDir)' != '' And Exists('$(OzzRuntimeLibrary)')">
    <Copy SourceFiles="$(OzzRuntimeLibrary)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
