<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NoWarn>IDE0130</NoWarn> <!-- disable "Namespace "Myth" does not match folder structure" -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RuntimeIdentifier)' != 'browser-wasm' and '$(MythBrowser)' != 'true' and '$(MythDesktopOnly)' != 'true'">net10.0;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('OSX')) or '$(RuntimeIdentifier)' == 'browser-wasm' or '$(MythBrowser)' == 'true' or '$(MythDesktopOnly)' == 'true'">net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);IOS</DefineConstants>
  </PropertyGroup>

  <!-- MythShip strips the editor from a published game build; ImGui stays available
       (potential in-game UI), so only EDITOR is dropped. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm' and '$(MythBrowser)' != 'true'">
    <DefineConstants Condition="'$(MythTestShip)' == 'true'">$(DefineConstants);IMGUI</DefineConstants>
    <DefineConstants Condition="'$(MythTestShip)' != 'true' and '$(MythShip)' != 'true'">$(DefineConstants);EDITOR;IMGUI</DefineConstants>
    <DefineConstants Condition="'$(MythTestShip)' != 'true' and '$(MythShip)' == 'true'">$(DefineConstants);IMGUI</DefineConstants>
    <!-- Marks the published/ship build; dev tools guarded with #if !MYTHSHIP (e.g. the
         MythCapture window recorder) then compile out of a ship publish. -->
    <DefineConstants Condition="'$(MythShip)' == 'true'">$(DefineConstants);MYTHSHIP</DefineConstants>
  </PropertyGroup>

  <!-- Dear ImGui is available in the browser when the prebuilt cimgui wasm archive
       exists (built by tools/build-cimgui-web.sh). -->
  <PropertyGroup Condition="('$(RuntimeIdentifier)' == 'browser-wasm' or '$(MythBrowser)' == 'true') and Exists('../Platforms/Web/Native/cimgui.a')">
    <MythBrowserImGui>true</MythBrowserImGui>
    <DefineConstants>$(DefineConstants);IMGUI</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(MythBrowser)' == 'true'">
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <MythBrowserFmod Condition="'$(MythBrowserFmod)' == ''">true</MythBrowserFmod>
    <MythBrowserJsFmod Condition="'$(MythBrowserJsFmod)' == ''">true</MythBrowserJsFmod>
    <MythBrowserFmodPThread Condition="'$(MythBrowserFmodPThread)' == ''">false</MythBrowserFmodPThread>
  </PropertyGroup>

  <ItemGroup>
    <CoreCompileCache Include="$(DefineConstants)" />
    <Compile Include="**/*.cs" Exclude="Program.cs;**/bin/**;**/obj/**;External/StringBuilder/tests/**" />
    <ProjectReference Include="../../Foster/Framework/Foster.Framework.csproj" Private="false" AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);FosterBrowserFmodPThread=$(MythBrowserFmodPThread);FosterBrowserJsFmod=$(MythBrowserJsFmod)" />
    <ProjectReference Include="../../OutLoud/OutLoud.csproj" />
    <!-- Build-time only: emits GeneratedActors.RegisterAll() from [GameActor]. -->
    <ProjectReference Include="../tools/Myth.SourceGen/Myth.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- ImGui.NET provides the managed bindings on every platform. On desktop it also
       carries the native cimgui; in the browser we link our own wasm build instead. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm' and '$(MythBrowser)' != 'true'">
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <!-- Managed bindings only; the native cimgui wasm archive is linked by the app project (Myth.csproj). -->
  <ItemGroup Condition="'$(MythBrowserImGui)' == 'true'">
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" ExcludeAssets="native" />
  </ItemGroup>

</Project>
