<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationTitle>Myth</ApplicationTitle>
    <ApplicationId>com.kevinwatters.myth</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <MtouchLink>SdkOnly</MtouchLink>
    <StartupObject>MythIos.Program</StartupObject>
    <PartialAppManifest>Info.plist</PartialAppManifest>
    <AppIcon>AppIcon</AppIcon>
    <DefineConstants>$(DefineConstants);IOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey Condition="'$(CodesignKey)' == ''">Apple Development</CodesignKey>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'DebugInterp' ">
    <CodesignKey Condition="'$(CodesignKey)' == ''">Apple Development</CodesignKey>
    <MtouchInterpreter>all,-MythIos,-Foster.Framework</MtouchInterpreter>
    <MtouchLink>SdkOnly</MtouchLink>
    <TrimMode>copy</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ImageAsset Include="Assets.xcassets/**/*" />
    <!-- Bundled content ships as one zip when it has been built (see tools/run-ios-device.sh);
         otherwise fall back to loose files so a plain build still works. FMOD banks always
         ship loose: FMOD opens them by real path. -->
    <BundleResource Include="../../../Assets/Content.zip" Condition="Exists('../../../Assets/Content.zip')">
      <LogicalName>Assets/Content.zip</LogicalName>
    </BundleResource>
    <BundleResource Include="../../../Assets/**/*" Condition="!Exists('../../../Assets/Content.zip')"
                    Exclude="../../../Assets/**/.DS_Store;../../../Assets/Sounds/**;../../../Assets/Sources/Sounds/**">
      <LogicalName>Assets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </BundleResource>
    <BundleResource Include="../../../Assets/Sounds/FMOD/Build/Mobile/*.bank">
      <LogicalName>Assets/Sounds/FMOD/Build/Mobile/%(Filename)%(Extension)</LogicalName>
    </BundleResource>
    <ProjectReference Include="../../../Source/Myth.Core.csproj" />
    <ProjectReference Include="../../../../Foster/Framework/Foster.Framework.csproj" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../Native/SDL3.xcframework')">
    <NativeReference Include="../Native/SDL3.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="Exists('../Native/cimgui.xcframework')">
    <NativeReference Include="../Native/cimgui.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AudioToolbox" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AVFoundation" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="AVFAudio" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and Exists('../../../../Foster/Framework/Internal/Native/ios/libfmod_iphoneos.a')">
    <NativeReference Include="../../../../Foster/Framework/Internal/Native/ios/libfmodstudio_iphoneos.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="../../../../Foster/Framework/Internal/Native/ios/libfmod_iphoneos.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <Target Name="GenerateIosAppIcons"
          BeforeTargets="_CompileImageAssets">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)../../../tools/generate-ios-icons.sh&quot; &quot;$(MSBuildThisFileDirectory)../../../AppIcon.png&quot; &quot;$(MSBuildThisFileDirectory)Assets.xcassets/AppIcon.appiconset&quot;" />
  </Target>

</Project>
