[
  {
    "label": "simple",
    "command": "dotnet watch run --no-restore -- --simple",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "gym",
    "command": "dotnet watch run -c Release --no-restore -- --gym",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "gym (unthrottled)",
    "command": "dotnet watch run -c Release --no-restore -- --gym --unthrottled",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "dotnet watch",
    "command": "dotnet watch run --non-interactive --no-restore --property:RunAnalyzers=false",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "dotnet run",
    "command": "dotnet run --no-restore",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "open in browser",
    "command": "./tools/run-browser.mjs",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    /* todo: needs --no-restore prefix dir hack */
    "label": "dotnet watch (MythTestShip)",
    "command": "dotnet watch run --non-interactive --property:MythTestShip=true -- --content-zip Assets/Content.zip",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "publish Windows to Steam Deck",
    "command": "ssh bro.fritz.box 'cd /d C:\\Users\\kev\\src\\Myth && git pull --ff-only && git submodule update --init && cd Myth && node tools\\publish-windows.mjs && curl.exe -fsS -X POST http://127.0.0.1:32010/post_event -H \"Content-Type: application/json\" --data-binary \"{\\\"type\\\":\\\"build\\\",\\\"status\\\":\\\"success\\\",\\\"name\\\":\\\"Myth\\\"}\"'",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
    "use_new_terminal": true,
  },
  {
    "label": "install Steam Deck library art",
    "command": "./Myth/tools/install-steam-deck-art.sh",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
    "use_new_terminal": true,
  }
]
