[
  {
    "label": "simple",
    "command": "dotnet watch run --no-restore --non-interactive --property:UseFosterDll=true -- --simple",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "gym",
    "command": "dotnet watch run -c Release --no-restore --property:UseFosterDll=true -- --gym",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "gym (unthrottled)",
    "command": "dotnet watch run -c Release --no-restore --property:UseFosterDll=true -- --gym --unthrottled",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "dotnet watch",
    "command": "dotnet watch run --no-restore --non-interactive --property:UseFosterDll=true",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "Play",
    "command": "./tools/dev-play.sh",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
    "reveal": "never",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false,
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
  },
  {
    "label": "dotnet watch (Sokoban)",
    "command": "dotnet watch run --non-interactive --no-restore --property:RunAnalyzers=false",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Sokoban",
  },
  {
    "label": "open in browser",
    "command": "./tools/run-browser.mjs",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    /* todo: needs --no-restore prefix dir hack */
    "label": "dotnet watch (MythTestShip)",
    "command": "dotnet watch run --non-interactive --property:MythTestShip=true --property:UseFosterDll=true -- --content-pak obj/Content/mac/Assets/Content.pak",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth",
  },
  {
    "label": "publish Windows to Steam Deck",
    "command": "echo SSHing into bro... && ssh bro.local 'cd /d C:\\Users\\kev\\src\\Myth && git pull --ff-only && git submodule update --init && cd Myth && node tools\\publish-windows.mjs && curl.exe -fsS -X POST http://127.0.0.1:32010/post_event -H \"Content-Type: application/json\" --data-binary \"{\\\"type\\\":\\\"build\\\",\\\"status\\\":\\\"success\\\",\\\"name\\\":\\\"Myth\\\"}\"'",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
    "use_new_terminal": true,
  },
  {
    "label": "install Steam Deck library art",
    "command": "./Myth/tools/install-steam-deck-art.sh",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
    "use_new_terminal": true,
  },
  {
    "label": "Pitch deck: build HTML",
    "command": "./build-html.sh",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth/Production/Pitch Deck",
  },
  {
    "label": "Pitch deck: deploy",
    "command": "./deploy.sh",
    "cwd": "$ZED_MAIN_GIT_WORKTREE/Myth/Production/Pitch Deck",
  }
]
