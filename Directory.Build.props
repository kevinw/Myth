<Project>
  <!-- Keep desktop/browser/iOS restore/build state separate. The shared default obj/
       lets each flavor overwrite project.assets.json and other generated files, which
       breaks no-restore loops when switching targets. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BaseIntermediateOutputPath)' == ''">
    <!-- Analyzer project references build with RuntimeIdentifier undefined but restore with it
         defined, so a RID-derived flavor restores project.assets.json to one obj/ flavor and
         then fails the build looking for it in another. -->
    <_FosterGamesIntermediateFlavor Condition="'$(RuntimeIdentifier)' != '' and '$(MSBuildProjectName)' != 'Myth.SourceGen'">$(RuntimeIdentifier)</_FosterGamesIntermediateFlavor>
    <_FosterGamesIntermediateFlavor Condition="'$(_FosterGamesIntermediateFlavor)' == '' and '$(MythBrowser)' == 'true'">browser-wasm</_FosterGamesIntermediateFlavor>
    <_FosterGamesIntermediateFlavor Condition="'$(_FosterGamesIntermediateFlavor)' == ''">desktop</_FosterGamesIntermediateFlavor>
    <!-- Ship flavors drop the editor, and MythShip also drops the diagnostics PackageReference.
         Sharing restore state with the dev flavor leaves the next no-restore build compiling
         KIT_DIAGNOSTICS against an assets file that no longer lists the package. -->
    <_FosterGamesIntermediateFlavor Condition="'$(MythShip)' == 'true'">$(_FosterGamesIntermediateFlavor)-ship</_FosterGamesIntermediateFlavor>
    <_FosterGamesIntermediateFlavor Condition="'$(MythTestShip)' == 'true'">$(_FosterGamesIntermediateFlavor)-testship</_FosterGamesIntermediateFlavor>
    <BaseIntermediateOutputPath>obj/$(_FosterGamesIntermediateFlavor)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
