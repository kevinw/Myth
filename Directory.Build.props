<Project>
  <!--
    Shared build properties for all Myth projects (Foster, TinyLink, etc.)
  -->

  <PropertyGroup>
    <!-- Shader compilation tools - bundled in tools directory -->
    <ShaderCrossPath Condition="'$(ShaderCrossPath)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)tools/windows/bin/shadercross.exe</ShaderCrossPath>
    <ShaderCrossPath Condition="'$(ShaderCrossPath)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(MSBuildThisFileDirectory)tools/macos/shadercross</ShaderCrossPath>
    <ShaderCrossPath Condition="'$(ShaderCrossPath)' == ''">shadercross</ShaderCrossPath>
  </PropertyGroup>

</Project>
